<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: the microphone needs this entitlement (voice chat), or macOS never
       shows the permission prompt and capture returns silence. Metal, audio output, network
       sockets (not sandboxed) and ~/Library/Application Support need none. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
