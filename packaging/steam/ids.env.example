# Copy to ids.env (gitignored) and fill in from Steamworks. Ids are not secrets; passwords never go here.
STEAM_BUILDER=your_builder_account_name
STEAM_FULL_APPID=0000000
STEAM_FULL_DEPOT_WIN=0000001
STEAM_FULL_DEPOT_MAC=0000002
STEAM_DEMO_APPID=0000010
STEAM_DEMO_DEPOT_WIN=0000011
STEAM_DEMO_DEPOT_MAC=0000012
