<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Pacenote: third-party notices</title>
<style>body{font:14px/1.5 system-ui,sans-serif;max-width:56rem;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap;background:#f4f4f4;padding:1rem}</style></head>
<body>
<h1>Third-party notices</h1>
<p>Pacenote contains the open-source software listed below. Art and sound credits are in CREDITS.txt.</p>
<h2>Licences used</h2>
<ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}</p>
<pre>{{text}}</pre>
{{/each}}
</body></html>
