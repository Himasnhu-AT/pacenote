/target
.DS_Store
# Raw downloads (CC0/CC-BY sources): keep locally, ship cooked copies in assets/.
/assets_src/*
!/assets_src/SOURCES.md

# Texture sources (regenerated by tools/art/prep_textures.sh / render_cards.py); the cooked
# .ktx2 + color.avg are committed.
/assets/textures/*/*.jpg
/assets/textures/*/*.png

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Packaging output (Steam folders, zips, steamcmd logs) and local Steam ids.
/dist/
/packaging/steam/ids.env
__pycache__/
.claude/worktrees/
